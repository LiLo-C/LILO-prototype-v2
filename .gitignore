build/
DerivedData/
.build/
*.moved-aside
*.hmap
*.ipa
*.dSYM
*.dSYM.zip

# Code signing (never commit these)
*.mobileprovision
*.p12
*.cer

# Playgrounds
timeline.xctimeline
playground.xcworkspace
